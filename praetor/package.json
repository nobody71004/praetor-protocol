{
  "name": "@praetor/protocol",
  "version": "0.1.0",
  "description": "PRAETOR/1 — a post-quantum authenticated transport and enforcement protocol with misuse-resistant AEAD, hybrid key establishment, and fixed-cell framing.",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./transport": "./src/transport.js",
    "./browser": "./browser/dist/praetor.mjs"
  },
  "bin": {
    "praetor": "./bin/praetor.js"
  },
  "scripts": {
    "test": "node --test",
    "bench": "node bench/bench.js",
    "build:browser": "node browser/build.mjs",
    "test:browser": "node browser/build.mjs && node browser/test.mjs",
    "selftest": "node bin/praetor.js selftest",
    "manifest": "node bin/praetor.js manifest"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "^0.4.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
